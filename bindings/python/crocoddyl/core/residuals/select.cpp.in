template <typename Model>
struct ResidualModelSelectVisitor
    : public bp::def_visitor<ResidualModelSelectVisitor<Model>> {
  typedef typename Model::ResidualDataAbstract Data;
  typedef typename Model::Base ModelBase;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("__init__",
           bp::make_constructor(&init, bp::default_call_policies(),
                                bp::args("residual", "rows")),
           "Initialize the selection residual model.\n\n"
           ":param residual: residual model to take the rows from\n"
           ":param rows: sequence of row indices to keep, in the wanted order")
        .def(
            "calc",
            static_cast<void (Model::*)(
                const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                const Eigen::Ref<const VectorXs>&)>(&Model::calc),
            bp::args("self", "data", "x", "u"),
            "Compute the selected rows of the wrapped residual.\n\n"
            ":param data: residual data\n"
            ":param x: state point (dim. state.nx)\n"
            ":param u: control input (dim. nu)")
        .def("calc",
             static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                         const Eigen::Ref<const VectorXs>&)>(
                 &Model::calc),
             bp::args("self", "data", "x"))
        .def(
            "calcDiff",
            static_cast<void (Model::*)(
                const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
                const Eigen::Ref<const VectorXs>&)>(&Model::calcDiff),
            bp::args("self", "data", "x", "u"),
            "Compute the Jacobians of the selected rows.\n\n"
            "It assumes that calc has been run first.\n"
            ":param data: residual data\n"
            ":param x: state point (dim. state.nx)\n"
            ":param u: control input (dim. nu)")
        .def("calcDiff",
             static_cast<void (Model::*)(const std::shared_ptr<Data>&,
                                         const Eigen::Ref<const VectorXs>&)>(
                 &Model::calcDiff),
             bp::args("self", "data", "x"))
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the selection residual data.\n\n"
             "It also allocates the data of the wrapped residual, sharing the "
             "same shared data.\n"
             ":param data: shared data\n"
             ":return residual data.")
        .add_property(
            "residual",
            bp::make_function(&Model::get_residual,
                              bp::return_value_policy<bp::return_by_value>()),
            "wrapped residual model")
        .add_property("rows", bp::make_function(&getRows),
                      "indices of the kept rows");
  }
  static std::shared_ptr<Model> init(std::shared_ptr<ModelBase> residual,
                                     const bp::object& rows) {
    return std::make_shared<Model>(residual, extractRows(rows));
  }
  static std::vector<std::size_t> extractRows(const bp::object& rows) {
    std::vector<std::size_t> out;
    bp::stl_input_iterator<bp::object> it(rows), end;
    for (; it != end; ++it) {
      const long int row = bp::extract<long int>(*it);
      if (row < 0) {
        throw_pretty("Invalid argument: "
                     << "the row index cannot be negative (" << row
                     << " given)");
      }
      out.push_back(static_cast<std::size_t>(row));
    }
    return out;
  }
  static bp::list getRows(const Model& self) {
    bp::list out;
    const std::vector<std::size_t>& rows = self.get_rows();
    for (std::size_t i = 0; i < rows.size(); ++i) {
      out.append(rows[i]);
    }
    return out;
  }
};

template <typename Data>
struct ResidualDataSelectVisitor
    : public bp::def_visitor<ResidualDataSelectVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
        "residual",
        bp::make_getter(&Data::residual,
                        bp::return_value_policy<bp::return_by_value>()),
        "data of the wrapped residual");
  }
};

#define CROCODDYL_RESIDUAL_MODEL_SELECT_PYTHON_BINDINGS(Scalar)              \
  typedef ResidualModelSelectTpl<Scalar> Model;                              \
  typedef ResidualModelAbstractTpl<Scalar> ModelBase;                        \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model, bp::bases<ModelBase>>(                                   \
      "ResidualModelSelect",                                                 \
      "This residual function keeps a subset of the rows of another "        \
      "residual, i.e. r = S * rbar(x, u).\n\n"                               \
      "Costs can already ignore rows through an activation model with zero " \
      "weights, but ConstraintModelResidual takes no activation: every row " \
      "of the residual it is given becomes a constraint row. This class is " \
      "how a constraint is placed on part of a residual -- for instance "    \
      "pinning the position, pitch and yaw of a landing foot while leaving " \
      "its roll free, by selecting rows (0, 1, 2, 4, 5) of a "               \
      "ResidualModelFramePlacement. The rows are taken in the order given, " \
      "and the state, nu and q/v/u dependency flags are inherited from the " \
      "wrapped residual.",                                                   \
      bp::no_init)                                                           \
      .def(ResidualModelSelectVisitor<Model>())                              \
      .def(CastVisitor<Model>())                                             \
      .def(PrintableVisitor<Model>())                                        \
      .def(CopyableVisitor<Model>());

#define CROCODDYL_RESIDUAL_DATA_SELECT_PYTHON_BINDINGS(Scalar)     \
  typedef ResidualDataSelectTpl<Scalar> Data;                      \
  typedef ResidualDataAbstractTpl<Scalar> DataBase;                \
  typedef ResidualModelSelectTpl<Scalar> Model;                    \
  typedef DataCollectorAbstractTpl<Scalar> DataCollector;          \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();             \
  bp::class_<Data, bp::bases<DataBase>>(                           \
      "ResidualDataSelect", "Data for the selection residual.",    \
      bp::init<Model*, DataCollector*>(                            \
          bp::args("self", "model", "data"),                       \
          "Create the selection residual data.\n\n"                \
          ":param model: selection residual model\n"               \
          ":param data: shared data")[bp::with_custodian_and_ward< \
          1, 2, bp::with_custodian_and_ward<1, 3>>()])             \
      .def(ResidualDataSelectVisitor<Data>())                      \
      .def(CopyableVisitor<Data>());

void exposeResidualSelect() {
  CROCODDYL_RESIDUAL_MODEL_SELECT_PYTHON_BINDINGS(@SCALAR_TYPE@)
  CROCODDYL_RESIDUAL_DATA_SELECT_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

