            bp::make_getter(&Data::constraints,
                            bp::return_value_policy<bp::return_by_value>()),
            "user-defined constraint data")
        .add_property(
            "u_act",
            bp::make_getter(&Data::u_act, bp::return_internal_reference<>()),
