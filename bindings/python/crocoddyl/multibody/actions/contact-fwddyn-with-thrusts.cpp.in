    Scalar)                                                                  \
  typedef IntegratedActionDataEulerWithThrustsTpl<Scalar> Data;              \
  typedef ActionDataAbstractTpl<Scalar> DataBase;                            \
  typedef IntegratedActionModelEulerWithThrustsTpl<Scalar> Model;            \
  bp::register_ptr_to_python<std::shared_ptr<Data>>();                       \
  bp::class_<Data, bp::bases<DataBase>>(                                     \
      "IntegratedActionDataEulerWithThrusts",                                \
      "Action data for the Euler integrator with thrusts.",                  \
      bp::init<Model*>(bp::args("self", "model"),                            \
                       "Create the Euler integrator data.\n\n"               \
                       ":param model: Euler integrator model"))              \
      .def(IntegratedActionDataEulerWithThrustsVisitor<Data>())              \
      .def(CopyableVisitor<Data>());

void exposeDifferentialActionContactFwdDynamicsWithThrusts() {
  // Each macro introduces its own `Model`/`Data` typedefs, so keep them in
  // separate scopes.
  {
    CROCODDYL_ACTION_MODEL_CONTACT_FWDDYN_WITH_THRUSTS_PYTHON_BINDINGS(
        @SCALAR_TYPE@)
  }
  {
    CROCODDYL_ACTION_DATA_CONTACT_FWDDYN_WITH_THRUSTS_PYTHON_BINDINGS(
        @SCALAR_TYPE@)
  }
  {
    CROCODDYL_INTEGRATED_ACTION_MODEL_EULER_WITH_THRUSTS_PYTHON_BINDINGS(
        @SCALAR_TYPE@)
  }
  {
    CROCODDYL_INTEGRATED_ACTION_DATA_EULER_WITH_THRUSTS_PYTHON_BINDINGS(
        @SCALAR_TYPE@)
  }
}

