#define CROCODDYL_INTEGRATED_ACTION_MODEL_EULER_WITH_THRUSTS_PYTHON_BINDINGS( \
    Scalar)                                                                   \
  typedef IntegratedActionModelEulerWithThrustsTpl<Scalar> Model;             \
  typedef ActionModelAbstractTpl<Scalar> ModelBase;                           \
  typedef typename Model::DifferentialModel DifferentialModel;                \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                       \
  bp::class_<Model, bp::bases<ModelBase>>(                                    \
      "IntegratedActionModelEulerWithThrusts",                                \
      "Sympletic Euler integrator for systems with an augmented thrust "      \
      "state.\n\n"                                                            \
      "It wraps DifferentialActionModelContactFwdDynamicsWithThrusts and "    \
      "performs the Euler step dx = [v*dt + a*dt^2, a*dt, df*dt] on the "     \
      "state x = [q, v, f].",                                                 \
      bp::init<std::shared_ptr<DifferentialModel>, bp::optional<Scalar>>(     \
          bp::args("self", "diffModel", "stepTime"),                          \
          "Initialize the Euler integrator.\n\n"                              \
          ":param diffModel: differential action model with thrusts\n"        \
          ":param stepTime: step time (default 1e-3)"))                       \
      .def(IntegratedActionModelEulerWithThrustsVisitor<Model>())             \
      .def(CastVisitor<Model>())                                              \
      .def(PrintableVisitor<Model>())                                         \
      .def(CopyableVisitor<Model>());

