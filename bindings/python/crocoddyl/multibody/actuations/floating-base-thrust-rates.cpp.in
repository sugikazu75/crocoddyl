            "W_thrust",
            bp::make_getter(&Data::W_thrust, bp::return_internal_reference<>()),
            "matrix mapping from thrusts and joint torques to generalized "
            "torques")
        .add_property(
            "S", bp::make_getter(&Data::S, bp::return_internal_reference<>()),
            "selection matrix for the under-actuation part");
  }
};

#define CROCODDYL_ACTUATION_MODEL_FLOATINGBASE_THRUSTER_RATES_PYTHON_BINDINGS( \
    Scalar)                                                                    \
  typedef ActuationModelFloatingBaseThrusterRatesTpl<Scalar> Model;            \
  typedef ActuationModelAbstractTpl<Scalar> ModelBase;                         \
  typedef DistributedThrusterTpl<Scalar> Thruster;                             \
  typedef StateMultibodyWithThrustsTpl<Scalar> StateWithThrusts;               \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                        \
  bp::class_<Model, bp::bases<ModelBase>>(                                     \
      "ActuationModelFloatingBaseThrusterRates",                               \
      "Actuation model for floating-base systems whose control is the rate "   \
      "of change of the thrust.\n\n"                                           \
      "It is meant to be used with StateMultibodyWithThrusts, which stores "   \
      "the current thrust f in the state. The control is u = [df (nf), joint " \
      "torques (nv - nv_floating)] and the generalized torque is tau = "       \
      "W(q)[:, :nf] * f + W(q)[:, nf:] * tau_joints, i.e. the thrust-rate "    \
      "block only enters the dynamics through the state integration.",         \
      bp::init<std::shared_ptr<StateWithThrusts>, std::vector<Thruster>>(      \
          bp::args("self", "state", "thrusters"),                              \
          "Initialize the floating-base thruster-rates actuation model.\n\n"   \
          ":param state: augmented multibody state with thrusts\n"             \
          ":param thrusters: vector of distributed thrusters"))                \
      .def(ActuationModelFloatingBaseThrusterRatesVisitor<Model>())            \
      .def(CastVisitor<Model>())                                               \
      .def(PrintableVisitor<Model>())                                          \
      .def(CopyableVisitor<Model>());

