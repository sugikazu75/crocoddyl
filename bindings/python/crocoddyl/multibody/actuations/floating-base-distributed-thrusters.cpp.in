template <typename Model>
struct DistributedThrusterVisitor
    : public bp::def_visitor<DistributedThrusterVisitor<Model>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def_readwrite("frame_id", &Model::frame_id_, "thruster frame id")
        .def_readwrite("joint_M_thruster", &Model::joint_M_thruster_,
                       "thruster pose in the parent-joint frame")
        .def_readwrite("ctorque", &Model::ctorque_,
                       "coefficient of generated torque per thrust")
        .def_readwrite("direction", &Model::direction_,
                       "type of thruster (clockwise or counterclockwise)")
        .def_readwrite("min_thrust", &Model::min_thrust_, "minimum thrust")
        .def_readwrite("max_thrust", &Model::max_thrust_, "maximum thrust")
        .def_readwrite("delta_thrust_max", &Model::delta_thrust_max_,
                       "maximum change of thrust (thrust-rate limit)")
        .def_readonly("thrust_wrench_unit", &Model::thrust_wrench_unit_,
                      "unit wrench generated by the thruster, expressed in "
                      "the thruster frame")
        .def_readonly("thrust_wrench_unit_parent_joint",
                      &Model::thrust_wrench_unit_parent_joint_,
                      "unit wrench generated by the thruster, expressed in "
                      "the parent-joint frame");
  }
};

template <typename Model>
struct ActuationModelFloatingBaseDistributedThrustersVisitor
    : public bp::def_visitor<
          ActuationModelFloatingBaseDistributedThrustersVisitor<Model>> {
  typedef typename Model::ActuationDataAbstract Data;
  typedef typename Model::VectorXs VectorXs;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("calc",
           static_cast<void (Model::*)(
               const std::shared_ptr<Data>&, const Eigen::Ref<const VectorXs>&,
               const Eigen::Ref<const VectorXs>&)>(&Model::calc),
           bp::args("self", "data", "x", "u"),
           "Compute the actuation signal from the thrust forces and joint "
           "torque inputs u.\n\n"
           "The thrust-to-torque mapping W(q) is rebuilt at every call from "
           "the thruster-frame Jacobians, so it depends on the configuration "
           "q.\n"
           ":param data: floating-base distributed thrusters actuation data\n"
           ":param x: state point (dim. state.nx)\n"
           ":param u: thrust and joint torque input (dim. nu)")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x", "u"),
             "Compute the derivatives of the actuation model.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: floating-base distributed thrusters actuation "
             "data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param u: thrust and joint torque input (dim. nu)")
        .def("commands", &Model::commands, bp::args("self", "data", "x", "tau"),
             "Compute the thrust and joint torque commands from the "
             "generalized torques.\n\n"
             "It stores the results in data.u.\n"
             ":param data: actuation data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param tau: generalized torques (dim state.nv)")
        .def("torqueTransform", &Model::torqueTransform,
             bp::args("self", "data", "x", "tau"),
             "Compute the torque transform from generalized torques to thrust "
             "and joint torque inputs.\n\n"
             "It stores the results in data.Mtau.\n"
             ":param data: actuation data\n"
             ":param x: state point (dim. state.nx)\n"
             ":param tau: generalized torques (dim state.nv)")
        .def("createData", &Model::createData, bp::args("self"),
             "Create the floating-base distributed thrusters actuation data.")
        .add_property(
            "thrusters",
            bp::make_function(&Model::get_thrusters,
                              bp::return_value_policy<bp::return_by_value>()),
            "vector of distributed thrusters")
        .add_property("nthrusters", bp::make_function(&Model::get_nthrusters),
                      "number of thrusters");
  }
};

template <typename Data>
struct ActuationDataFloatingBaseDistributedThrustersVisitor
    : public bp::def_visitor<
          ActuationDataFloatingBaseDistributedThrustersVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
          "pinocchio",
          bp::make_getter(&Data::pinocchio, bp::return_internal_reference<>()),
          "pinocchio data")
        .add_property(
            "W_thrust",
            bp::make_getter(&Data::W_thrust, bp::return_internal_reference<>()),
            "matrix mapping from thrusts and joint torques to generalized "
            "torques")
        .add_property(
            "S", bp::make_getter(&Data::S, bp::return_internal_reference<>()),
            "selection matrix for the under-actuation part");
  }
};

#define CROCODDYL_DISTRIBUTED_THRUSTER_PYTHON_BINDINGS(Scalar)                \
  typedef DistributedThrusterTpl<Scalar> Thruster;                            \
  typedef typename pinocchio::SE3Tpl<Scalar> SE3;                             \
  bp::register_ptr_to_python<std::shared_ptr<Thruster>>();                    \
  StdVectorPythonVisitor<std::vector<Thruster>, true>::expose(                \
      "StdVec_DistributedThruster");                                          \
  bp::class_<Thruster>(                                                       \
      "DistributedThruster",                                                  \
      "Model for a thruster attached to an arbitrary robot frame.\n\n"        \
      "Unlike Thruster, whose pose is fixed w.r.t. the root joint, a "        \
      "DistributedThruster is attached to a frame of the kinematic tree, so " \
      "its thrust-to-torque mapping depends on the configuration q.",         \
      bp::init<int, SE3, Scalar,                                              \
               bp::optional<DistributedThrusterType, Scalar, Scalar, Scalar>>( \
          bp::args("self", "frame_id", "joint_M_thruster", "ctorque",         \
                   "direction", "min_thrust", "max_thrust",                   \
                   "delta_thrust_max"),                                       \
          "Initialize the distributed thruster.\n\n"                          \
          ":param frame_id: id of the thruster frame\n"                       \
          ":param joint_M_thruster: thruster pose in the parent-joint frame\n" \
          ":param ctorque: coefficient of generated torque per thrust\n"      \
          ":param direction: type of thruster (clockwise or "                 \
          "counterclockwise, default DT_CW)\n"                                \
          ":param min_thrust: minimum thrust (default 0.)\n"                  \
          ":param max_thrust: maximum thrust (default np.inf)\n"              \
          ":param delta_thrust_max: maximum thrust rate (default np.inf)"))   \
      .def(DistributedThrusterVisitor<Thruster>())                            \
      .def(CastVisitor<Thruster>())                                           \
      .def(CopyableVisitor<Thruster>());

#define CROCODDYL_ACTUATION_MODEL_FLOATINGBASE_DISTRIBUTED_THRUSTERS_PYTHON_BINDINGS( \
    Scalar)                                                                    \
  typedef ActuationModelFloatingBaseDistributedThrustersTpl<Scalar> Model;      \
  typedef ActuationModelAbstractTpl<Scalar> ModelBase;                          \
  typedef DistributedThrusterTpl<Scalar> Thruster;                              \
  typedef StateMultibodyTpl<Scalar> StateMultibody;                             \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                         \
  bp::class_<Model, bp::bases<ModelBase>>(                                      \
      "ActuationModelFloatingBaseDistributedThrusters",                         \
      "Actuation model for floating-base systems actuated with thrusters "      \
      "distributed over the kinematic tree (e.g. articulated aerial "           \
      "robots).\n\n"                                                            \
      "The control is u = [thrusts (nf), joint torques (nv - nv_floating)] "    \
      "and the generalized torque is tau = W(q) * u, where W(q) is rebuilt "    \
      "from the thruster-frame Jacobians at every calc call.",                  \
      bp::init<std::shared_ptr<StateMultibody>, std::vector<Thruster>>(         \
          bp::args("self", "state", "thrusters"),                               \
          "Initialize the floating-base actuation model equipped with "         \
          "distributed thrusters.\n\n"                                          \
          ":param state: state of the multibody system\n"                       \
          ":param thrusters: vector of distributed thrusters"))                 \
      .def(ActuationModelFloatingBaseDistributedThrustersVisitor<Model>())      \
      .def(CastVisitor<Model>())                                                \
      .def(PrintableVisitor<Model>())                                           \
      .def(CopyableVisitor<Model>());

