namespace crocoddyl {
namespace python {

template <typename State>
struct StateMultibodyWithThrustsVisitor
    : public bp::def_visitor<StateMultibodyWithThrustsVisitor<State>> {
  typedef typename State::Scalar Scalar;
  typedef typename State::VectorXs VectorXs;
  BOOST_PYTHON_MEMBER_FUNCTION_OVERLOADS(Jdiffs,
                                         StateAbstractTpl<Scalar>::Jdiff_Js, 2,
                                         3)
  BOOST_PYTHON_MEMBER_FUNCTION_OVERLOADS(
      Jintegrates, StateAbstractTpl<Scalar>::Jintegrate_Js, 2, 3)
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def("zero", &State::zero, bp::args("self"),
           "Return the neutral robot configuration with zero velocity and "
           "zero thrust.\n\n"
           ":return zero state [q_neutral, 0_v, 0_f]")
        .def("rand", &State::rand, bp::args("self"),
             "Return a random reference state.\n\n"
             ":return random reference state")
        .def("diff", &State::diff_dx, bp::args("self", "x0", "x1"),
             "Operator that differentiates the two augmented states.\n\n"
             "The q part uses the Lie algebra of the configuration manifold; "
             "the velocity and thrust parts are Euclidean.\n"
             ":param x0: current state (dim state.nx()).\n"
             ":param x1: next state (dim state.nx()).\n"
             ":return x1 - x0 value (dim state.ndx()).")
        .def("integrate", &State::integrate_x, bp::args("self", "x", "dx"),
             "Operator that integrates the current augmented state.\n\n"
             "The q part uses the Lie algebra of the configuration manifold; "
             "the velocity and thrust parts are Euclidean.\n"
             ":param x: current state (dim state.nx()).\n"
             ":param dx: displacement of the state (dim state.ndx()).\n"
             ":return x + dx value (dim state.nx()).")
        .def("safe_diff", &safe_diff_dx, bp::args("self", "x0", "x1"),
             "Sanitized diff operator that neutralises invalid components and "
             "propagates NaNs where the result cannot be trusted.\n\n"
             ":param x0: current state (dim state.nx()).\n"
             ":param x1: next state (dim state.nx()).\n"
             ":return x1 - x0 value with NaNs on invalid entries (dim "
             "state.ndx()).")
        .def("safe_integrate", &safe_integrate_x, bp::args("self", "x", "dx"),
             "Sanitized integrate operator that clamps invalid inputs and "
             "marks affected entries with NaNs.\n\n"
             ":param x: current state (dim state.nx()).\n"
             ":param dx: displacement of the state (dim state.ndx()).\n"
             ":return x + dx value with NaNs on invalid entries (dim "
             "state.nx()).")
        .def("Jdiff", &State::Jdiff_Js,
             Jdiffs(bp::args("self", "x0", "x1", "firstsecond"),
                    "Compute the partial derivatives of the diff operator.\n\n"
                    "The resulting Jacobians are block diagonal: the "
                    "configuration block comes from pinocchio's dDifference "
                    "while the velocity and thrust blocks are +/- identity. By "
                    "default, this function returns the derivatives of the "
                    "first and second argument (i.e. firstsecond='both').\n"
                    ":param x0: current state (dim state.nx()).\n"
                    ":param x1: next state (dim state.nx()).\n"
                    ":param firstsecond: derivative w.r.t x0 or x1 or both\n"
                    ":return the partial derivative(s) of the diff(x0, x1) "
                    "function"))
        .def("Jintegrate", &State::Jintegrate_Js,
             Jintegrates(
                 bp::args("self", "x", "dx", "firstsecond"),
                 "Compute the partial derivatives of arithmetic addition.\n\n"
                 "The resulting Jacobians are block diagonal: the "
                 "configuration block comes from pinocchio's dIntegrate while "
                 "the velocity and thrust blocks are the identity. By default, "
                 "this function returns the derivatives of the first and "
                 "second argument (i.e. firstsecond='both').\n"
                 ":param x: current state (dim state.nx()).\n"
                 ":param dx: displacement of the state (dim state.ndx()).\n"
                 ":param firstsecond: derivative w.r.t x or dx or both\n"
                 ":return the partial derivative(s) of the integrate(x, dx) "
                 "function"))
        .def("JintegrateTransport", &State::JintegrateTransport,
             bp::args("self", "x", "dx", "Jin", "firstsecond"),
             "Parallel transport from integrate(x, dx) to x.\n\n"
             "Only the configuration-tangent rows are transported; the "
             "velocity and thrust rows are Euclidean and left unchanged.\n"
             ":param x: state point (dim. state.nx).\n"
             ":param dx: velocity vector (dim state.ndx).\n"
             ":param Jin: input matrix (number of rows = state.ndx).\n"
             ":param firstsecond: derivative w.r.t x or dx")
        .add_property(
            "state",
            bp::make_function(&State::get_state,
                              bp::return_value_policy<bp::return_by_value>()),
            "underlying multibody state")
        .add_property(
            "pinocchio",
            bp::make_function(&State::get_pinocchio,
                              bp::return_value_policy<bp::return_by_value>()),
            "pinocchio model")
        .add_property("nthrusters",
                      bp::make_function(&State::get_nthrusters),
                      "number of thrusters (dimension of the thrust state)");
  }
  static VectorXs safe_diff_dx(const State& state, const VectorXs& x0,
                               const VectorXs& x1) {
    VectorXs dx(state.get_ndx());
    state.safe_diff(x0, x1, dx);
    return dx;
  }
  static VectorXs safe_integrate_x(const State& state, const VectorXs& x,
                                   const VectorXs& dx) {
    VectorXs xout(state.get_nx());
    state.safe_integrate(x, dx, xout);
    return xout;
  }
};

#define CROCODDYL_STATE_MULTIBODY_WITH_THRUSTS_PYTHON_BINDINGS(Scalar)        \
  typedef StateMultibodyWithThrustsTpl<Scalar> State;                         \
  typedef StateAbstractTpl<Scalar> StateBase;                                 \
  typedef StateMultibodyTpl<Scalar> StateMultibody;                           \
  bp::register_ptr_to_python<std::shared_ptr<State>>();                       \
  bp::class_<State, bp::bases<StateBase>>(                                    \
      "StateMultibodyWithThrusts",                                            \
      "Augmented multibody state that includes the current thrust forces.\n\n" \
      "The state vector is x = [q (nq), v (nv), f (nf)], where q is the "     \
      "robot configuration, v its generalized velocity and f the current "    \
      "thruster forces. The tangent vector is dx = [dq (nv), dv (nv), df "    \
      "(nf)], hence nx = nq + nv + nf and ndx = 2*nv + nf. The q/v part is "  \
      "handled by an internal StateMultibody while the f part is treated as " \
      "a plain Euclidean variable.",                                          \
      bp::init<std::shared_ptr<StateMultibody>, std::size_t>(                 \
          bp::args("self", "state", "nthrusters"),                            \
          "Initialize the augmented multibody state.\n\n"                     \
          ":param state: underlying multibody state (provides the q/v "       \
          "operators)\n"                                                      \
          ":param nthrusters: number of thrusters (dimension of f)")          \
          [bp::with_custodian_and_ward<1, 2>()])                              \
      .def(StateMultibodyWithThrustsVisitor<State>())                         \
      .def(CastVisitor<State>())                                              \
      .def(PrintableVisitor<State>())                                         \
      .def(CopyableVisitor<State>());

void exposeStateMultibodyWithThrusts() {
  CROCODDYL_STATE_MULTIBODY_WITH_THRUSTS_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

