template <typename Model>
struct LineWrenchConeVisitor
    : public bp::def_visitor<LineWrenchConeVisitor<Model>> {
  typedef typename Model::Scalar Scalar;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<>(bp::args("self"),
                      "Default initialization of the line wrench cone."))
        .def("update", &Model::update, bp::args("self"),
             "Update the linear inequality (matrix and bounds).\n\n"
             "Run this function if you have changed one of the parameters.")
        .add_property(
            "A",
            bp::make_function(&Model::get_A, bp::return_internal_reference<>()),
            "inequality matrix")
        .add_property("ub",
                      bp::make_function(&Model::get_ub,
                                        bp::return_internal_reference<>()),
                      "inequality upper bound")
        .add_property("lb",
                      bp::make_function(&Model::get_lb,
                                        bp::return_internal_reference<>()),
                      "inequality lower bound")
        .add_property("nf", bp::make_function(&Model::get_nf),
                      "number of facets")
        .add_property("nr", bp::make_function(&Model::get_nr),
                      "number of inequalities")
        .add_property("length", bp::make_function(&Model::get_length),
                      &Model::set_length, "length of the contact line")
        .add_property("mu", bp::make_function(&Model::get_mu), &Model::set_mu,
                      "friction coefficient")
        .add_property("inner_appr", bp::make_function(&Model::get_inner_appr),
                      &Model::set_inner_appr,
                      "type of friction cone approximation")
        .add_property("min_nforce", bp::make_function(&Model::get_min_nforce),
                      &Model::set_min_nforce, "minimum normal force")
        .add_property("max_nforce", bp::make_function(&Model::get_max_nforce),
                      &Model::set_max_nforce, "maximum normal force");
  }
};

#define CROCODDYL_LINE_WRENCH_CONE_PYTHON_BINDINGS(Scalar)                   \
  typedef LineWrenchConeTpl<Scalar> Model;                                   \
  typedef WrenchConeTpl<Scalar> SurfaceModel;                                \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                      \
  bp::class_<Model>(                                                         \
      "LineWrenchCone",                                                      \
      "Model of the wrench cone of a line contact as lb <= A lambda <= ub\n" \
      "\n"                                                                   \
      "This is the degenerate case of WrenchCone for a support box of zero " \
      "width, written directly on the 5d wrench (f_h, f_b, f_n, tau_b, "     \
      "tau_n) that a line contact can transmit. It takes no rotation "       \
      "matrix: the cone is always expressed in the contact frame of "        \
      "ContactModelRolling, whose x axis is the contact line and whose z "   \
      "axis is the surface normal.",                                         \
      bp::init<Scalar, Scalar,                                               \
               bp::optional<std::size_t, bool, Scalar, Scalar>>(             \
          bp::args("self", "mu", "length", "nf", "inner_appr", "min_nforce",  \
                   "max_nforce"),                                            \
          "Initialize the linearized line wrench cone.\n\n"                  \
          ":param mu: friction coefficient\n"                                \
          ":param length: length of the contact line\n"                      \
          ":param nf: number of facets (default 4)\n"                        \
          ":param inner_appr: inner or outer approximation (default True)\n" \
          ":param min_nforce: minimum normal force (default 0.)\n"           \
          ":param max_nforce: maximum normal force (default "                \
          "sys.float_info.max)"))                                            \
      .def(bp::init<SurfaceModel>(                                           \
          bp::args("self", "cone"),                                          \
          "Initialize the line wrench cone from a surface one.\n\n"          \
          "The width of the support box is ignored.\n"                       \
          ":param cone: surface wrench cone"))                               \
      .def(LineWrenchConeVisitor<Model>())                                   \
      .def(CastVisitor<Model>())                                             \
      .def(PrintableVisitor<Model>())                                        \
      .def(CopyableVisitor<Model>());

void exposeLineWrenchCone() {
  CROCODDYL_LINE_WRENCH_CONE_PYTHON_BINDINGS(@SCALAR_TYPE@)
}

}  // namespace python
}  // namespace crocoddyl
