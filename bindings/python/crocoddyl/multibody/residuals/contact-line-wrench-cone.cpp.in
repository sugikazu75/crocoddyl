template <typename Data>
struct ResidualDataContactLineWrenchConeVisitor
    : public bp::def_visitor<ResidualDataContactLineWrenchConeVisitor<Data>> {
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.add_property(
        "contact",
        bp::make_getter(&Data::contact,
                        bp::return_value_policy<bp::return_by_value>()),
        bp::make_setter(&Data::contact),
        "contact data associated with the current residual");
  }
};

