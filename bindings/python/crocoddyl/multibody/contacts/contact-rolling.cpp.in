template <typename Model>
struct ContactModelRollingVisitor
    : public bp::def_visitor<ContactModelRollingVisitor<Model>> {
  typedef typename Model::Scalar Scalar;
  typedef typename Model::StateMultibody State;
  typedef typename Model::SE3 SE3;
  typedef typename Model::Vector2s Vector2s;
  typedef typename Model::Vector3s Vector3s;
  template <class PyClass>
  void visit(PyClass& cl) const {
    cl.def(bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Scalar, SE3,
                    bp::optional<Vector2s, Vector3s>>(
               bp::args("self", "state", "id", "radius", "pref", "gains",
                        "axis"),
               "Initialize the rolling contact model.\n\n"
               ":param state: state of the multibody system\n"
               ":param id: reference frame id, placed on the cylinder axis\n"
               ":param radius: radius of the cylindrical sole\n"
               ":param pref: support placement used for the Baumgarte "
               "stabilization\n"
               ":param gains: gains of the contact model (default "
               "np.array([0.,0.]))\n"
               ":param axis: rolling axis in the reference frame (default "
               "np.array([1.,0.,0.]))"))
        .def("calc", &Model::calc, bp::args("self", "data", "x"),
             "Compute the rolling contact Jacobian and drift.\n\n"
             ":param data: contact data\n"
             ":param x: state point (dim. state.nx)")
        .def("calcDiff", &Model::calcDiff, bp::args("self", "data", "x"),
             "Compute the derivatives of the rolling contact holonomic "
             "constraint.\n\n"
             "It assumes that calc has been run first.\n"
             ":param data: contact data\n"
             ":param x: state point (dim. state.nx)")
        .def("updateForce", &Model::updateForce,
             bp::args("self", "data", "force"),
             "Convert the force into a stack of spatial forces.\n\n"
             ":param data: contact data\n"
             ":param force: force vector (dimension 5)")
        .def("createData", &Model::createData,
             bp::with_custodian_and_ward_postcall<0, 2>(),
             bp::args("self", "data"),
             "Create the rolling contact data.\n\n"
             ":param data: Pinocchio data\n"
             ":return contact data.")
        .add_property("radius", &Model::get_radius, &Model::set_radius,
                      "radius of the cylindrical sole")
        .add_property(
            "reference",
            bp::make_function(&Model::get_reference,
                              bp::return_value_policy<bp::return_by_value>()),
            &Model::set_reference, "support placement")
        .add_property(
            "axis",
            bp::make_function(&Model::get_axis,
                              bp::return_value_policy<bp::return_by_value>()),
            &Model::set_axis, "rolling axis in the reference frame")
        .add_property(
            "gains",
            bp::make_function(&Model::get_gains,
                              bp::return_value_policy<bp::return_by_value>()),
            "contact gains");
  }
};

