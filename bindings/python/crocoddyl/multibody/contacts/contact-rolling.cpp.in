#define CROCODDYL_CONTACT_MODEL_ROLLING_PYTHON_BINDINGS(Scalar)                \
  typedef ContactModelRollingTpl<Scalar> Model;                                \
  typedef ContactModelAbstractTpl<Scalar> ModelBase;                           \
  typedef Model::StateMultibody State;                                         \
  typedef Model::SE3 SE3;                                                      \
  typedef Model::Vector2s Vector2s;                                            \
  typedef Model::Vector3s Vector3s;                                            \
  bp::register_ptr_to_python<std::shared_ptr<Model>>();                        \
  bp::class_<Model, bp::bases<ModelBase>>(                                     \
      "ContactModelRolling",                                                   \
      "Rigid rolling (line) contact model.\n\n"                                \
      "It describes a cylindrical foot lying on a flat support and free to "   \
      "roll about its own axis, which leaves 5 acceleration-based holonomic "  \
      "constraints: the material contact point does not move, and the sole "   \
      "neither pitches nor yaws. The reference frame must lie on the "         \
      "cylinder axis, and the support geometry is carried by pref: its z "     \
      "axis is the surface normal, its x axis the desired heading of the "     \
      "rolling axis.",                                                         \
      bp::init<std::shared_ptr<State>, pinocchio::FrameIndex, Scalar, SE3,     \
               std::size_t, bp::optional<Vector2s, Vector3s>>(                 \
          bp::args("self", "state", "id", "radius", "pref", "nu", "gains",     \
                   "axis"),                                                    \
          "Initialize the rolling contact model.\n\n"                          \
          ":param state: state of the multibody system\n"                      \
          ":param id: reference frame id, placed on the cylinder axis\n"       \
          ":param radius: radius of the cylindrical sole\n"                    \
          ":param pref: support placement used for the Baumgarte "             \
          "stabilization\n"                                                    \
          ":param nu: dimension of control vector\n"                           \
          ":param gains: gains of the contact model (default "                 \
          "np.array([0.,0.]))\n"                                               \
          ":param axis: rolling axis in the reference frame (default "         \
          "np.array([1.,0.,0.]))"))                                            \
      .def(ContactModelRollingVisitor<Model>())                                \
      .def(CastVisitor<Model>())                                               \
      .def(PrintableVisitor<Model>())                                          \
      .def(CopyableVisitor<Model>());

